<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.classList.add("js");</script>
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ '/assets/brand/logo.png' | htmlBaseUrl }}">
  <link rel="icon" type="image/png" href="/assets/brand/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/main.css">
</head>
<body class="min-h-screen overflow-x-hidden">

  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="glow-blob bg-primary" style="width: 34rem; height: 34rem; top: -12rem; left: -8rem;"></div>
    <div class="glow-blob bg-tertiary" style="width: 28rem; height: 28rem; top: 10rem; right: -10rem; opacity: 0.22;"></div>
    <div class="glow-blob bg-secondary" style="width: 26rem; height: 26rem; bottom: -10rem; left: 30%; opacity: 0.14;"></div>
  </div>

  <header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
    <nav class="glass glass-edge mx-auto flex max-w-7xl items-center justify-between rounded-2xl px-5 py-3">
      <a href="/" class="flex items-center gap-2.5 font-display text-lg font-semibold text-frost">
        <img src="/assets/brand/logo.png" alt="" class="-my-1.5 h-10 w-10">
        Arin
      </a>
      <div class="flex items-center gap-1 text-sm font-medium">
        <a href="/docs/" class="rounded-lg px-3 py-1.5 text-fog transition hover:bg-white/5 hover:text-frost">Docs</a>
        <a href="{{ site.repo }}" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-fog transition hover:bg-white/5 hover:text-frost">
          <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub
        </a>
      </div>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="mx-auto max-w-7xl px-6 pb-10 pt-20">
    <div class="glass rounded-2xl px-6 py-5">
      <div class="flex flex-col items-center justify-between gap-4 text-sm text-mist sm:flex-row">
        <p class="flex items-center gap-2">
          <img src="/assets/brand/logo.png" alt="" class="h-5 w-5">
          Arin draws. It never clicks.
        </p>
        <p>
          Open source under the
          <a href="{{ site.repo }}/blob/main/LICENSE" class="text-fog transition hover:text-frost">MIT License</a>
        </p>
        <div class="flex items-center gap-1">
          <a href="{{ site.repo }}" aria-label="GitHub" class="rounded-lg p-2 transition hover:bg-white/5 hover:text-frost">
            <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a href="https://x.com/kranirudha" aria-label="X" class="rounded-lg p-2 transition hover:bg-white/5 hover:text-frost">
            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          <a href="https://discord.gg/5YrbwNRGaE" aria-label="Discord" class="rounded-lg p-2 transition hover:bg-white/5 hover:text-frost">
            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var targets = document.querySelectorAll("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) {
        targets.forEach(function (el) { el.classList.add("is-visible"); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: "0px 0px -40px 0px" });
        targets.forEach(function (el) { io.observe(el); });
      }

      if (!reduced) {
        var blobs = document.querySelectorAll(".glow-blob");
        var ticking = false;
        window.addEventListener("scroll", function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = window.scrollY;
            blobs.forEach(function (blob, i) {
              blob.style.transform = "translateY(" + y * (i % 2 ? 0.08 : -0.05) + "px)";
            });
            ticking = false;
          });
        }, { passive: true });
      }
    })();
  </script>

</body>
</html>

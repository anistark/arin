---
layout: layouts/base.njk
backdrop: stars
---

{# A single column of prose, for pages that are not part of the documentation reading
   order and so want neither the sidebar nor the previous and next links. #}
<div class="mx-auto max-w-7xl px-6 pb-16 pt-32">
  <article class="glass glass-edge mx-auto max-w-4xl rounded-3xl px-6 py-8 sm:px-10 sm:py-10">
    <div class="prose prose-invert prose-arin max-w-none">
      {{ content | safe }}
    </div>
  </article>
</div>

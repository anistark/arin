<svg viewBox="0 0 640 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-auto w-full" role="img" aria-label="A mock screen with Arin marks drawn on it: a pointing orb, a highlight box, a text note, and a hand-drawn circle">
  <defs>
    <radialGradient id="hero-orb-halo" cx="50%" cy="50%" r="50%">
      <stop offset="10%" stop-color="#4C8DFF" stop-opacity="0.85"/>
      <stop offset="45%" stop-color="#4C8DFF" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#4C8DFF" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="hero-orb-core" cx="50%" cy="42%" r="60%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="40%" stop-color="#A9DCFF"/>
      <stop offset="100%" stop-color="#4C8DFF"/>
    </radialGradient>
    <linearGradient id="hero-window" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.09"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.03"/>
    </linearGradient>
  </defs>

  <!-- Mock window -->
  <rect x="20" y="20" width="600" height="380" rx="18" fill="url(#hero-window)" stroke="#FFFFFF" stroke-opacity="0.12"/>
  <circle cx="46" cy="44" r="5" fill="#FF5F57" opacity="0.8"/>
  <circle cx="64" cy="44" r="5" fill="#FEBC2E" opacity="0.8"/>
  <circle cx="82" cy="44" r="5" fill="#28C840" opacity="0.8"/>
  <line x1="20" y1="64" x2="620" y2="64" stroke="#FFFFFF" stroke-opacity="0.08"/>

  <!-- Fake page content -->
  <g fill="#FFFFFF">
    <rect x="52" y="92" width="220" height="12" rx="6" opacity="0.16"/>
    <rect x="52" y="120" width="420" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="138" width="390" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="156" width="410" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="196" width="330" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="214" width="360" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="232" width="300" height="8" rx="4" opacity="0.08"/>
    <rect x="52" y="286" width="150" height="34" rx="8" opacity="0.1"/>
    <rect x="76" y="299" width="102" height="8" rx="4" opacity="0.2"/>
    <rect x="52" y="344" width="380" height="8" rx="4" opacity="0.08"/>
  </g>

  <!-- Green highlight over a paragraph -->
  <g class="mark-fade mark-fade-2">
    <rect x="44" y="186" width="390" height="62" rx="10" fill="#3DDC97" fill-opacity="0.08"/>
    <rect class="mark-rect" x="44" y="186" width="390" height="62" rx="10" stroke="#3DDC97" stroke-width="2"/>
    <rect x="340" y="166" width="150" height="24" rx="7" fill="#0A1020" stroke="#3DDC97" stroke-opacity="0.5"/>
    <text x="352" y="182" font-family="JetBrains Mono, monospace" font-size="11" fill="#8AEEC4">the key paragraph</text>
  </g>

  <!-- Purple annotation note -->
  <g class="mark-fade mark-fade-3">
    <rect x="452" y="270" width="158" height="76" rx="10" fill="#0A1020" fill-opacity="0.85" stroke="#A78BFA" stroke-opacity="0.6"/>
    <text x="466" y="296" font-family="JetBrains Mono, monospace" font-size="11" fill="#C9B8FF">This button submits</text>
    <text x="466" y="314" font-family="JetBrains Mono, monospace" font-size="11" fill="#C9B8FF">the form. Click it</text>
    <text x="466" y="332" font-family="JetBrains Mono, monospace" font-size="11" fill="#C9B8FF">when you are done.</text>
    <path class="mark-path" d="M452 308 C 400 316, 340 316, 240 306" stroke="#A78BFA" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- Blue orb pointing at the button -->
  <g class="mark-fade mark-fade-1">
    <circle class="orb-pulse" cx="127" cy="303" r="34" fill="url(#hero-orb-halo)"/>
    <circle cx="127" cy="303" r="12" fill="url(#hero-orb-core)"/>
    <rect x="152" y="252" width="76" height="24" rx="7" fill="#0A1020" stroke="#4C8DFF" stroke-opacity="0.5"/>
    <text x="164" y="268" font-family="JetBrains Mono, monospace" font-size="11" fill="#8FB8FF">Save</text>
  </g>

  <!-- Freehand blue circle around the heading -->
  <g class="mark-fade mark-fade-1">
    <path class="mark-path" d="M40 98 C 60 78, 250 74, 282 90 C 308 104, 260 118, 150 116 C 90 114, 48 110, 46 100" stroke="#4C8DFF" stroke-width="2.5" stroke-linecap="round" opacity="0.9"/>
  </g>
</svg>

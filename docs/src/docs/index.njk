---
layout: layouts/base.njk
title: Documentation
description: Everything you need to build, run, and drive Arin.
permalink: /docs/
---

<div class="mx-auto max-w-7xl px-6 pb-16 pt-36">
  <div class="max-w-2xl">
    <h1 class="font-display text-4xl font-bold tracking-tight text-frost sm:text-5xl">Documentation</h1>
    <p class="mt-4 text-lg text-mist">
      Everything you need to install Arin, run the daemon, drive it from an agent or a
      shell, and work on it.
    </p>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    {% for group in docsGroups %}
    <div class="glass glass-edge group relative flex flex-col rounded-2xl p-6 transition hover:border-white/20">
      <a href="/docs/{{ group.slug }}/" class="font-display text-xl font-semibold text-frost transition group-hover:text-primary-soft">
        {{ group.title }}
        <span class="absolute inset-0" aria-hidden="true"></span>
      </a>
      <p class="mt-2 text-sm leading-relaxed text-mist">{{ group.description }}</p>

      <ul class="relative z-10 mt-5 flex flex-col gap-1 border-t border-white/10 pt-4">
        {% for doc in group.docs %}
        <li>
          <a href="/docs/{{ doc.slug }}/" class="-mx-2 block rounded-lg px-2 py-1.5 text-sm text-fog transition hover:bg-white/5 hover:text-frost">
            {{ doc.title }}
          </a>
        </li>
        {% endfor %}
      </ul>

      <span class="mt-5 inline-block text-sm font-medium text-primary-soft">
        {{ group.docs[0].title }} &rarr;
      </span>
    </div>
    {% endfor %}
  </div>
</div>

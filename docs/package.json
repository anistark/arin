{
  "name": "arin-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "eleventy && tailwindcss -i src/styles/main.css -o _site/assets/main.css --minify",
    "dev": "npm-run-all --parallel dev:*",
    "dev:eleventy": "eleventy --serve --quiet",
    "dev:css": "tailwindcss -i src/styles/main.css -o _site/assets/main.css --watch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "markdown-it-anchor": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
